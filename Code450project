# MOBILENET MODEL
model_m = models.mobilenet_v2(weights=MobileNet_V2_Weights.DEFAULT)

for param in model_m.features.parameters():
    param.requires_grad = False

model_m.classifier[1] = nn.Linear(model_m.last_channel, 2)

criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model_m.classifier.parameters(), lr=0.0001)

# TRAIN MOBILENET
for epoch in range(5):
    model_m.train()
    correct = 0
    total = 0
    total_loss = 0

    for images, labels in train_loader_m:
        outputs = model_m(images)
        loss = criterion(outputs, labels)

        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

        total_loss += loss.item()

        _, predicted = torch.max(outputs, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()

    train_acc = 100 * correct / total
    avg_loss = total_loss / len(train_loader_m)

    print(f"Epoch {epoch+1}: Loss = {avg_loss:.4f}, Train Accuracy = {train_acc:.2f}%")

