# Unnormalize function
def unnormalize(img):
    img = img.numpy().transpose(1, 2, 0)
    mean = [0.485, 0.456, 0.406]
    std = [0.229, 0.224, 0.225]
    img = std * img + mean
    img = img.clip(0, 1)
    return img

